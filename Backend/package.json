{
  "name": "conquest-backend",
  "version": "1.0.0",
  "description": "CONQUEST - turn-based geopolitics strategy game API (Express + MongoDB), deployable to Vercel",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed-countries.js",
    "check:groq": "node scripts/check-groq.js",
    "test": "node --test",
    "test:unit": "node --test test/models.test.js test/groq.test.js test/engine/battle.test.js test/engine/game.test.js test/engine/npc.test.js",
    "test:api": "node --test test/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
