# Copy to .env for local development. On Vercel, set these under Project -> Settings -> Environment Variables.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
# In Atlas Network Access, allow 0.0.0.0/0 so Vercel's serverless functions can reach the cluster.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=conquest

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (Expo web dev server + your deployed frontend).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Free key from https://console.groq.com/keys - battle commentary falls back to templates without it.
# Verify it with: npm run check:groq
GROQ_API_KEY=
# Llama 3.x models were retired on Groq's free tier in Aug 2026; gpt-oss is the recommended replacement.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

# Optional: `npm run seed` creates (or resets the password of) this account for the examiners.
DEMO_USERNAME=examiner
DEMO_EMAIL=examiner@conquest.app
DEMO_PASSWORD=
