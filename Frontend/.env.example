# Copy to .env for local development. On Vercel, set these under Project -> Settings -> Environment Variables.
# EXPO_PUBLIC_* values are baked into the bundle at build time, so redeploy after changing them.

# Backend base URL, without a trailing slash or /api.
#   Local web / iOS simulator: http://localhost:4000
#   Android emulator:          http://10.0.2.2:4000
#   Phone on the same Wi-Fi:   http://<your-PC-LAN-IP>:4000
#   Deployed:                  https://<your-backend>.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:4000

# Public URL of the deployed web app, used for share links from the native app.
EXPO_PUBLIC_WEB_URL=
